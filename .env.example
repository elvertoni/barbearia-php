# Conexão com o banco de dados
DB_HOST=db
DB_PORT=3306
DB_NAME=barbearia
DB_USER=barbearia_user
DB_PASS=barbearia_pass

# Ambiente: dev | prod (prod ativa cookie de sessão Secure)
APP_ENV=dev

# Usuário dono inicial (usado por database/seed.php)
ADMIN_NOME=Dono da Barbearia
ADMIN_EMAIL=dono@barbearia.local
ADMIN_SENHA=trocar-esta-senha
